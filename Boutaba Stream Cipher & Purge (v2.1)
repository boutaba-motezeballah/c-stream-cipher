section .data

section .bss
    buffer       resb 4096
    source_file  resb 256
    output_file  resb 256
    secret_key   resb 128
    mode         resb 4
    src_fd       resq 1
    dest_fd      resq 1
    key_len      resq 1

section .text
    global _start

_start:
    mov rax, 0
    mov rdi, 0
    mov rsi, mode
    mov rdx, 4
    syscall

    mov rax, 0
    mov rdi, 0
    mov rsi, source_file
    mov rdx, 256
    syscall
    call .strip_newline

    mov rax, 0
    mov rdi, 0
    mov rsi, output_file
    mov rdx, 256
    syscall
    call .strip_newline

    mov rax, 0
    mov rdi, 0
    mov rsi, secret_key
    mov rdx, 128
    syscall
    call .strip_newline
    mov [key_len], rax

    cmp rax, 4
    jl .exit_error

    mov rax, 2
    mov rdi, source_file
    mov rsi, 0
    mov rdx, 0
    syscall
    cmp rax, 0
    jl .exit_error
    mov [src_fd], rax

    mov rax, 2
    mov rdi, output_file
    mov rsi, 577
    mov rdx, 432
    syscall
    cmp rax, 0
    jl .close_src_error
    mov [dest_fd], rax

    xor r9, r9
    xor r10, r10

.read_loop:
    mov rax, 0
    mov rdi, [src_fd]
    mov rsi, buffer
    mov rdx, 4096
    syscall
    mov r11, rax
    cmp r11, 0
    jle .cipher_complete

    xor rsi, rsi
.process_bytes:
    cmp rsi, r11
    jge .write_block

    mov rax, r9
    xor rdx, rdx
    mov rbx, 7
    div rbx
    mov r10, rdx

    movzx rbx, byte [secret_key + r9]
    xor rbx, r10
    xor byte [buffer + rsi], bl

    inc r9
    mov rax, r9
    xor rdx, rdx
    mov rbx, [key_len]
    div rbx
    mov r9, rdx

    inc rsi
    jmp .process_bytes

.write_block:
    mov rax, 1
    mov rdi, [dest_fd]
    mov rsi, buffer
    mov rdx, r11
    syscall
    jmp .read_loop

.cipher_complete:
    mov rax, 3
    mov rdi, [src_fd]
    syscall
    mov rax, 3
    mov rdi, [dest_fd]
    syscall

    xor rsi, rsi
.purge_loop:
    cmp rsi, 4096
    jge .check_shred
    mov byte [buffer + rsi], 0
    inc rsi
    jmp .purge_loop

.check_shred:
    movzx rax, byte [mode]
    cmp rax, '1'
    jne .exit_success

    mov rax, 87
    mov rdi, source_file
    syscall

.exit_success:
    mov rax, 60
    xor rdi, rdi
    syscall

.close_src_error:
    mov rax, 3
    mov rdi, [src_fd]
    syscall
.exit_error:
    mov rax, 60
    mov rdi, 1
    syscall

.strip_newline:
    xor rcx, rcx
.loop_strip:
    cmp rcx, rax
    jge .done_strip
    mov dl, byte [rsi + rcx]
    cmp dl, 10
    je .found_nl
    cmp dl, 13
    je .found_nl
    inc rcx
    jmp .loop_strip
.found_nl:
    mov byte [rsi + rcx], 0
.done_strip:
    mov rax, rcx
    ret
